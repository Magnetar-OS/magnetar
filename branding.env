# Single source of truth for the distribution's identity.
#
# A magnetar is a neutron star with a magnetic field a thousand trillion times
# Earth's — the most extreme magnetic objects known. magnetaros.com is
# registered.
#
# Everything that names the distribution reads from here. Renaming touches
# published artifacts (repo URLs, package names, os-release ID), so if it ever
# changes again, do it before an ISO is public, not after.

# Lowercase, [a-z0-9-] only. Package prefix, pacman repo name, os-release ID.
DISTRO_ID="magnetar"

# Display name, as shown in os-release PRETTY_NAME, the greeter and fastfetch.
DISTRO_NAME="Magnetar"

# ISO volume label. Uppercase, <= 11 chars for ISO-9660, no spaces.
DISTRO_LABEL="MAGNETAR"

# Reverse-DNS prefix for anything that needs an app ID.
DISTRO_RDNN="com.magnetaros.Magnetar"

DISTRO_URL="https://magnetaros.com"
DISTRO_BUGS="https://github.com/Magnetar-OS/magnetar/issues"
DISTRO_DOCS="https://github.com/Magnetar-OS/magnetar/blob/main/docs"

# The pacman repository. One repository for distribution packages and the
# application suite both — see docs/REPOS.md.
#
# A custom domain, not a github.io URL: this address ends up in every installed
# machine's pacman.conf, and a github.io address encodes the organisation name.
DISTRO_REPO_NAME="magnetar"
DISTRO_REPO_URL="https://repo.magnetaros.com"

# Upstream ISO tooling, pinned to a commit. iso/sync.sh builds from exactly
# this commit, so an ISO build is reproducible and an upstream change reaches
# it only through a reviewed bump here. The nightly Packages run fails its
# "upstream" job when UPSTREAM_ISO_BRANCH has moved past the pin: re-run
# iso/sync.sh and tools/gen-iso-packages.py at the new commit, review, bump.
UPSTREAM_ISO_REPO="https://github.com/CachyOS/CachyOS-Live-ISO.git"
UPSTREAM_ISO_BRANCH="master"
UPSTREAM_ISO_REF="4937780541814b4b0ec7c212c00fe06299f799b6"  # master, 2026-08-12
