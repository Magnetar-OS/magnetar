# Single source of truth for the distribution's identity.
#
# The name is not settled — `pharos` is a placeholder. Every file in this repo
# that names the distribution reads it from here or is rewritten by
# `tools/rename.sh`, so changing it later is one command, not an audit.
#
# Renaming touches published artifacts (repo URLs, package names, os-release
# ID). Do it before the first public ISO, not after.

# Lowercase, [a-z0-9-] only. Package prefix, pacman repo name, os-release ID.
DISTRO_ID="pharos"

# Display name, as shown in os-release PRETTY_NAME, the greeter and fastfetch.
DISTRO_NAME="Pharos"

# ISO volume label. Uppercase, <= 11 chars for ISO-9660, no spaces.
DISTRO_LABEL="PHAROS"

# Reverse-DNS prefix for anything that needs an app ID.
DISTRO_RDNN="dev.entro314labs.Pharos"

DISTRO_URL="https://github.com/entro314-labs/pharos"
DISTRO_BUGS="https://github.com/entro314-labs/pharos/issues"
DISTRO_DOCS="https://github.com/entro314-labs/pharos/blob/main/docs"

# The pacman repository that serves this distribution's own packages.
# Separate from [entro314labs] (released apps) on purpose — see docs/REPOS.md.
DISTRO_REPO_NAME="pharos"
DISTRO_REPO_URL="https://entro314-labs.github.io/pharos-repo"

# Upstream ISO tooling, pinned. Bump deliberately; CI diffs the vendored
# util-iso.sh against this ref and fails when upstream has moved under us.
UPSTREAM_ISO_REPO="https://github.com/CachyOS/CachyOS-Live-ISO.git"
UPSTREAM_ISO_REF="master"
