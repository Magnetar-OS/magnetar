#!/usr/bin/env bash
#
# Launch the Magnetar installer.
#
# Calamares' configuration is assembled at runtime rather than shipped as a
# fork of CachyOS's. CachyOS maintains ~60 module configs — partitioning,
# LUKS, ZFS, mkinitcpio, bootloaders — and forking that set to change three
# files means inheriting the maintenance of all of them and silently falling
# behind their fixes.
#
# So: take theirs, lay ours over it, patch the lines that have to change
# (assemble-config.py: branding, no desktop chooser, Magnetar's package list,
# a target pacman.conf that carries [magnetar], a limine boot-entry group named
# after the installed system), and run Calamares against the result. Every patch asserts on the text it expects and fails loudly if
# CachyOS has moved.
set -euo pipefail

CONFDIR=/run/magnetar-calamares
OURS=/usr/share/magnetar/calamares
LOG=/home/liveuser/magnetar-install.log

die() { echo "magnetar-install: $*" >&2; exit 1; }

[[ $(id -u) -ne 0 ]] || die "run as the live user, not root; it escalates on its own"

echo "==> preparing keyrings"
# Same reasoning as CachyOS's installer: Arch re-signs its keyring often, and a
# live image whose keyring predates the current signing key fails the install
# with an error that looks like a network problem.
#
# On the live image /etc/pacman.d/gnupg is a tmpfs mount (archiso's
# etc-pacman.d-gnupg.mount), so it cannot be removed — `rm -rf` returns
# "Device or resource busy". CachyOS's script issues the same rm and survives
# only because it does not set -e. Re-initialising in place works fine, so
# check rather than delete blindly.
if mountpoint -q /etc/pacman.d/gnupg; then
  echo "    keyring directory is a mount; re-initialising in place"
else
  sudo rm -rf /etc/pacman.d/gnupg
fi
sudo pacman -Sy --noconfirm archlinux-keyring cachyos-keyring
sudo pacman-key --init
# magnetar too: the target's keyring is a copy of this one, and [magnetar] is
# SigLevel = Required.
sudo pacman-key --populate archlinux cachyos magnetar
sudo timedatectl set-ntp true || true

echo "==> ensuring Calamares is present"
sudo pacman -S --needed --noconfirm cachyos-calamares-next

echo "==> assembling configuration"
sudo rm -rf "$CONFDIR"
sudo mkdir -p "$CONFDIR"
sudo cp -a /etc/calamares/. "$CONFDIR/"
sudo cp /usr/share/calamares/settings_online.conf "$CONFDIR/settings.conf"

# Our module overrides win over CachyOS's.
sudo cp -a "$OURS/modules/." "$CONFDIR/modules/"

sudo python3 "$OURS/assemble-config.py" "$CONFDIR"

mkdir -p "$(dirname "$LOG")"
{
  echo "########## Magnetar install log"
  echo "########## started (UTC): $(date -u '+%F %T')"
  echo "########## ISO version: $(cat /etc/version-tag 2>/dev/null || echo unknown)"
  echo "########## firmware: $([ -d /sys/firmware/efi ] && echo UEFI || echo BIOS)"
  inxi -F 2>/dev/null || true
} > "$LOG"

echo "==> starting Calamares"
exec pkexec-wrapper calamares -c "$CONFDIR" -D6 >> "$LOG" 2>&1
