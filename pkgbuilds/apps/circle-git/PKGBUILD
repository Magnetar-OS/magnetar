# GENERATED by tools/gen-app-pkgbuilds.sh from pkgbuilds/apps/apps.txt.
# Edit the manifest or the generator, not this file.
#
# A -git package because circle is not tagged yet. When it cuts a release,
# linux-release-kit publishes a versioned package to [entro314labs] and this
# one should be deleted, not kept alongside it.
pkgname=circle-git
_pkgname=circle
pkgver=0.1.0.r0.gHEAD
pkgrel=1
pkgdesc="Contacts for the COSMIC desktop, stored as vCards in a vdir"
arch=('x86_64' 'aarch64')
url="https://github.com/entro314-labs/circle"
license=('GPL-3.0-or-later')

# The libcosmic base set, derived from what installed COSMIC applications
# actually link against rather than from reading Cargo.toml. Anything else is
# per-app and comes from namcap against a real build — CI reports it.
depends=('glib2' 'libxkbcommon' 'systemd-libs' 'zlib')

# Unversioned on purpose: rustup provides rust and cargo without a version, so
# a versioned makedepend can never be satisfied on a machine using it. The
# real minimum is rust-version in Cargo.toml, and cargo says so plainly.
makedepends=('cargo' 'git' 'just' 'pkgconf')

optdepends=(
  'khard: command-line access to the same vdir'
  'vdirsyncer: CardDAV sync'
)

provides=('circle')
conflicts=('circle')
source=("$pkgname::git+https://github.com/entro314-labs/circle.git")
sha256sums=('SKIP')
options=('!lto')  # the workspace sets its own lto profile in Cargo.toml

pkgver() {
  cd "$srcdir/$pkgname"
  # <cargo version>.r<commits>.g<hash> — sorts correctly and names the commit.
  printf "%s.r%s.g%s" \
    "$(awk -F'"' '/^version/ {print $2; exit}' Cargo.toml)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  # Fetch now so build() runs offline, which is what makechrootpkg expects.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  just build-release
}

check() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # No display, no compositor, no session bus in a build chroot. Tests that
  # need one are expected to be #[ignore]d upstream; if this fails, fix the
  # test rather than deleting check().
  cargo test --frozen --workspace
}

package() {
  cd "$srcdir/$pkgname"
  export CARGO_TARGET_DIR=target
  # The justfile owns the file list. Every app in the suite honours rootdir
  # and prefix, so the packager never has to restate where things go — and
  # never drifts from upstream when a file is added.
  just rootdir="$pkgdir" prefix=/usr install

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null \
    || install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
