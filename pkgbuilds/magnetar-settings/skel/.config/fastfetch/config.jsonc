// Magnetar fastfetch configuration.
//
// A custom logo because fastfetch keys its built-in art off the os-release ID,
// and "magnetar" is not one it ships art for. Without this it falls back to a
// generic Arch or Tux logo — the wrong name on the wrong distribution, which
// is exactly the sort of detail that makes a derivative feel like a reskin.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/magnetar/logo.txt",
    "color": { "1": "blue", "2": "cyan", "3": "white" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "cyan", "host": "blue" } },
    { "type": "custom", "format": "-----------------------------" },
    { "type": "os", "key": "  os        ", "keyColor": "cyan" },
    { "type": "kernel", "key": "  kernel    ", "keyColor": "cyan" },
    { "type": "packages", "key": "  packages  ", "keyColor": "cyan" },
    { "type": "de", "key": "  desktop   ", "keyColor": "cyan" },
    { "type": "terminal", "key": "  terminal  ", "keyColor": "cyan" },
    { "type": "cpu", "key": "  cpu       ", "keyColor": "cyan" },
    { "type": "gpu", "key": "  gpu       ", "keyColor": "cyan" },
    { "type": "memory", "key": "  memory    ", "keyColor": "cyan" },
    { "type": "disk", "key": "  disk      ", "keyColor": "cyan" },
    "break"
  ]
}
