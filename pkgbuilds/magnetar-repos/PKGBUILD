# Maintainer: Dominikos Pritis <hey@myroomie.gr>
#
# Owns the repository configuration and nothing else. Splitting this out from
# magnetar-settings is deliberate: repository order is the part of the system
# that breaks machines, and it should be inspectable, versioned and revertible
# on its own.
#
# This package does NOT overwrite /etc/pacman.conf on upgrade. It ships the
# canonical file to /usr/share/magnetar/pacman.conf and installs the drop-ins;
# adopting a new canonical pacman.conf is an explicit act (see the .install).
pkgname=magnetar-repos
pkgver=0.1.0
pkgrel=3
pkgdesc="Pacman repository configuration for Magnetar: ordered, signed, locked"
arch=('any')
url="https://github.com/Magnetar-OS/magnetar"
license=('GPL-3.0-or-later')

# Only what [cachyos] and Arch can actually provide at install time.
#
# The third-party keyrings are NOT dependencies, and this is the bug that
# building the first ISO exposed: a repository's keyring package lives inside
# the repository it verifies, so pacstrap on a fresh root cannot resolve it —
# the repo is not configured yet, because configuring it is what this package
# does. Those repositories therefore ship disabled, and `magnetar-repo enable`
# imports the key and fetches the keyring as a deliberate act.
depends=(
  'pacman'
  # Our own keyring first. pacman.conf sets SigLevel = Required for [magnetar],
  # so without this nothing from the repository installs — including, awkwardly,
  # the keyring itself. It has to arrive as a dependency, not from the repo it
  # protects.
  'magnetar-keyring'
  'cachyos-keyring' 'cachyos-mirrorlist' 'cachyos-v4-mirrorlist'
  'python'
)

optdepends=(
  'cachyos-v3-mirrorlist: x86-64-v3 rebuilds, for CPUs without AVX-512'
  'endeavouros-keyring: required before `magnetar-repo enable endeavouros`'
  'endeavouros-mirrorlist: required before `magnetar-repo enable endeavouros`'
  'chaotic-keyring: fetched automatically by `magnetar-repo enable chaotic-aur`'
  'chaotic-mirrorlist: fetched automatically by `magnetar-repo enable chaotic-aur`'
)

# Never both. Both ship -x86-64-v3/v4 rebuilds of core and extra; enabled
# together, repository order decides which build farm supplied each half of
# your base system. See "Forbidden combinations" in docs/REPOS.md.
conflicts=('alhp-keyring' 'alhp-mirrorlist')

backup=(
  'etc/pacman.d/magnetar-repos.d/60-chaotic-aur.conf'
  'etc/pacman.d/magnetar-repos.d/61-endeavouros.conf'
  'etc/pacman.d/magnetar-repos.d/62-garuda.conf'
  'etc/pacman.d/magnetar-repos.d/63-orhun.conf'
  'etc/pacman.d/magnetar-repos.d/64-quarry.conf'
  'etc/pacman.d/magnetar-repos.d/70-nemesis_repo.conf'
  'etc/pacman.d/magnetar-repos.d/71-arch4edu.conf'
  'etc/pacman.d/magnetar-repos.d/72-ownstuff.conf'
  'etc/pacman.d/magnetar-repos.d/73-andontie-aur.conf'
  'etc/pacman.d/magnetar-repos.d/74-Reborn-OS.conf'
  'etc/pacman.d/magnetar-repos.d/80-valve.conf'
  'etc/pacman.d/magnetar-repos.d/99-local.conf'
)

install="$pkgname.install"

# No source=(). makepkg resolves local source entries by basename, so a path
# like 'repos.d/60-endeavouros.conf' is looked for as '60-endeavouros.conf' in
# the build directory and fails. The nested layout is worth keeping — it mirrors
# where the files land on disk — so package() reads from $startdir instead.
# That is sound here: this package is only ever built from this repository,
# never from a released tarball.
source=()
sha256sums=()

package() {
  # The canonical file, for reference and for the installer to copy into
  # place on a fresh system. Deliberately not installed as /etc/pacman.conf:
  # overwriting a live pacman.conf on upgrade would silently revert whatever
  # the machine's owner had changed, including their locks.
  install -Dm644 "$startdir/pacman.conf" "$pkgdir/usr/share/magnetar/pacman.conf"

  # Every drop-in, generated from repos.d/. Adding a repository is a file,
  # not a code change.
  for f in "$startdir"/repos.d/*.conf; do
    install -Dm644 "$f" "$pkgdir/etc/pacman.d/magnetar-repos.d/$(basename "$f")"
  done

  install -Dm755 "$startdir/repo-audit.sh" "$pkgdir/usr/bin/magnetar-repo-audit"
  install -Dm755 "$startdir/magnetar-repo"  "$pkgdir/usr/bin/magnetar-repo"

  # The audit defaults to reading this path; without it every CachyOS override
  # is reported as a policy violation on a working system.
  install -Dm644 "$startdir/../../tools/repo-overrides.txt" \
    "$pkgdir/usr/share/magnetar/repo-overrides.txt"
}
